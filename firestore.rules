rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /attendanceRecords/{recordId} {
      allow read, write: if true;
    }

    match /employees/{employeeId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
